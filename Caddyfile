# CLIMIDEX — reverse proxy (derrière Cloudflare)
# Remplace climidex.fr par ton domaine réel.
#
# SSL Cloudflare : mettre le mode "Full" (le cert auto-signé `tls internal`
# de Caddy suffit puisque Cloudflare ne le vérifie pas en "Full").
# Pour passer en "Full (strict)" plus tard : remplace `tls internal` par
# `tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key` avec un
# certificat d'origine Cloudflare monté dans le conteneur.

{
	# Cloudflare transmet la vraie IP client via cet en-tête.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
	}
}

# --- API / Admin Medusa ---
api.climidex.fr {
	tls internal
	reverse_proxy backend:9000
}

# --- Boutique (Next.js) ---
climidex.fr, www.climidex.fr {
	tls internal
	encode gzip zstd
	reverse_proxy storefront:8000
}
