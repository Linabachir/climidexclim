# =====================================================================
# CLIMIDEX — variables de production (Hetzner + Cloudflare)
# Copier en `.env` sur le serveur : cp .env.production.example .env
# Générer les secrets : openssl rand -hex 32
# =====================================================================

# --- Domaine ---
# Remplace partout climidex.fr par ton domaine.

# --- Postgres (conteneur) ---
POSTGRES_USER=climidex
POSTGRES_PASSWORD=CHANGE_ME_mot_de_passe_fort
POSTGRES_DB=climidex

# --- Secrets Medusa (openssl rand -hex 32) ---
JWT_SECRET=CHANGE_ME_jwt_secret
COOKIE_SECRET=CHANGE_ME_cookie_secret

# --- URLs & CORS ---
MEDUSA_BACKEND_URL=https://api.climidex.fr
STORE_CORS=https://climidex.fr,https://www.climidex.fr
ADMIN_CORS=https://api.climidex.fr
AUTH_CORS=https://climidex.fr,https://www.climidex.fr,https://api.climidex.fr

# --- Stripe (clés LIVE) ---
STRIPE_API_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- CJ Dropshipping (si utilisé) ---
CJ_API_KEY=
CJ_API_BASE_URL=

# --- Cloudflare R2 (stockage images, S3-compatible) ---
# S3_ENDPOINT   = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_FILE_URL   = URL publique du bucket (domaine R2 public ou cdn.climidex.fr)
S3_BUCKET=climidex-media
S3_ENDPOINT=https://XXXXACCOUNTID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_REGION=auto
S3_FILE_URL=https://cdn.climidex.fr

# =====================================================================
# Storefront (Next.js) — variables PUBLIQUES (figées au build)
# =====================================================================
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.climidex.fr
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_xxx_depuis_admin_medusa
NEXT_PUBLIC_DEFAULT_REGION=fr
NEXT_PUBLIC_BASE_URL=https://climidex.fr
# Hôte qui sert les images (= domaine de S3_FILE_URL, sans https://)
NEXT_PUBLIC_IMAGE_HOSTNAME=cdn.climidex.fr
